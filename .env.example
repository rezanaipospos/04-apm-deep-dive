NEW_RELIC_LICENSE_KEY=your_ingest_license_key_here

# Automatic traffic (loadgen service) — seconds between full checkout loops
LOADGEN_INTERVAL_SEC=5
LOADGEN_LIGHT_EVERY=2

# Structured logging
LOG_LEVEL=info
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true

# --- Alerting as Code (Terragrunt) — see alerting-as-code/env.example ---
# User API key (NRAK-...), NOT the ingest license above:
# NEW_RELIC_ACCOUNT_ID=
# NEW_RELIC_USER_API_KEY=
# NEW_RELIC_REGION=US
