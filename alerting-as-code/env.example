# Copy to .env.alerting and: set -a; source .env.alerting; set +a
# User API key = Terraform/API (NRAK-...), NOT the ingest license key for Docker agents.

NEW_RELIC_ACCOUNT_ID=1234567
NEW_RELIC_USER_API_KEY=NRAK-xxxxxxxx
NEW_RELIC_REGION=US

# Optional — Slack notification destination + channel (skip if you only apply policy/conditions)
# NEW_RELIC_SLACK_DESTINATION_ID=
# NEW_RELIC_SLACK_CHANNEL_ID=
